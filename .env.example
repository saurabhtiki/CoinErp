# Copy to .env and fill in. Never commit .env.

# Which settings file: config.settings.dev | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# development | sandbox | production. Sandbox shows an orange bar and never sends real email.
# For servers use .env.prod.example and .env.sandbox.example instead of this file.
ENVIRONMENT=development

# Make a new one: uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Dev: SQLite file. Docker/prod: postgres://erp:PASSWORD@db:5432/erp
DATABASE_URL=sqlite:///db.sqlite3

# Used by the db container in Docker Compose
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me

# Scrambles the mail password saved in Admin -> Email settings. Make one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe and never change it: a lost key means typing the mail password again.
EMAIL_SETTINGS_KEY=
# Email (dev prints emails to the console). Easiest: set it up in Admin -> Email settings (superuser). The lines below are used until then.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Developer PC only: True sends real emails (using Admin -> Email settings). False/blank prints them in the server window.
SEND_REAL_EMAIL=False
# Seconds before giving up on a mail server that does not answer
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=erp@example.com
# Full site address, for links in emails
SITE_URL=http://localhost:8000

# Background jobs: number of worker processes in the worker container
Q_WORKERS=2

LOG_LEVEL=INFO
