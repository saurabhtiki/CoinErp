# Production server: copy to .env.prod and fill in. Never commit .env.prod.
# Start:  docker compose -p coinerp-prod --env-file .env.prod -f docker/compose.yml up -d --build

ENV_FILE=../.env.prod
WEB_PORT=8000

ENVIRONMENT=production

DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=change-me
ALLOWED_HOSTS=erp.example.com
CSRF_TRUSTED_ORIGINS=https://erp.example.com
SITE_URL=https://erp.example.com
# Caddy handles HTTPS; Django also redirects any plain-http request. Raise HSTS to 31536000 (1 year) once HTTPS works.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600

POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://erp:change-me@db:5432/erp

# Scrambles the mail password saved in Admin -> Email settings. Make one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe and never change it: a lost key means typing the mail password again.
EMAIL_SETTINGS_KEY=
# Email. Easiest: set it up in Admin -> Email settings (superuser). The lines below are used until then.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=erp@example.com

Q_WORKERS=2
LOG_LEVEL=INFO
