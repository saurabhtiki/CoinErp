# Production server: copy to .env.prod and fill in. Never commit .env.prod.
# Start:  docker compose -p coinerp-prod --env-file .env.prod -f docker/compose.yml up -d --build

ENV_FILE=../.env.prod
HTTP_PORT=80

ENVIRONMENT=production

DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=change-me
ALLOWED_HOSTS=erp.example.com
CSRF_TRUSTED_ORIGINS=https://erp.example.com
SITE_URL=https://erp.example.com
# No HTTPS yet (added in Part C): turn this off until then
SECURE_SSL_REDIRECT=False

POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://erp:change-me@db:5432/erp

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=erp@example.com

Q_WORKERS=2
LOG_LEVEL=INFO
