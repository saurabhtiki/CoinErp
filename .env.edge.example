# Settings of the Caddy front door. Copy to .env.edge. Never commit .env.edge.
# DNS: both names must point to this server's IP before you start Caddy (else no certificate).

ACME_EMAIL=you@example.com
PROD_DOMAIN=erp.example.com
SANDBOX_DOMAIN=sandbox.erp.example.com

# Extra shared password for the sandbox. Make the hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'the-password-you-choose'
# Keep the single quotes around the hash (it contains $ signs).
SANDBOX_USER=tester
SANDBOX_PASSWORD_HASH='paste-the-hash-here'
