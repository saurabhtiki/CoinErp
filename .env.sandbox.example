# Sandbox server: copy to .env.sandbox and fill in. Never commit .env.sandbox.
# Start:  docker compose -p coinerp-sandbox --env-file .env.sandbox -f docker/compose.yml up -d --build
# Then:   docker compose -p coinerp-sandbox --env-file .env.sandbox -f docker/compose.yml exec web python manage.py reset_sandbox --yes
# Use a DIFFERENT SECRET_KEY, database password and port from production.

ENV_FILE=../.env.sandbox
WEB_PORT=8001

# Shows the orange "SANDBOX" bar, stops real email, allows reset_sandbox
ENVIRONMENT=sandbox
# Password of the fake demo users (admin@demo.test, manager@demo.test, ...)
DEMO_PASSWORD=change-me-demo-password

DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=change-me-different-from-production
ALLOWED_HOSTS=sandbox.erp.example.com
CSRF_TRUSTED_ORIGINS=https://sandbox.erp.example.com
SITE_URL=https://sandbox.erp.example.com
# Caddy handles HTTPS; Django also redirects any plain-http request. Raise HSTS to 31536000 (1 year) once HTTPS works.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600

POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me-sandbox-db
DATABASE_URL=postgres://erp:change-me-sandbox-db@db:5432/erp

# Email is never sent from the sandbox, so no mail server is needed
DEFAULT_FROM_EMAIL=sandbox@example.com
Q_WORKERS=1
LOG_LEVEL=INFO
